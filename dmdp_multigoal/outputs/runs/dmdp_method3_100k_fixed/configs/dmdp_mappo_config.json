{
  "method": "dmdp_mappo",
  "seed": 7,
  "device": "cpu",
  "total_steps": 100000,
  "rollout_steps": 256,
  "num_epochs": 4,
  "minibatch_size": 512,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_ratio": 0.2,
  "entropy_coef": 0.01,
  "value_coef": 0.5,
  "learning_rate": 0.0003,
  "max_grad_norm": 0.5,
  "reward": {
    "cost_penalty": 0.1,
    "distribution_penalty": 0.05,
    "tail_penalty": 0.2
  },
  "network": {
    "hidden_sizes": [
      128,
      128
    ],
    "activation": "tanh"
  },
  "target_distribution": {
    "path": null,
    "fallback": "handcrafted"
  },
  "output": {
    "checkpoint": "outputs/runs/dmdp_method3_100k_fixed/checkpoints/dmdp_mappo_latest.pt",
    "metrics": "outputs/runs/dmdp_method3_100k_fixed/metrics/dmdp_mappo_train.json"
  }
}