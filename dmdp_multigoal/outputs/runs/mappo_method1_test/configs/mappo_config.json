{
  "method": "mappo",
  "seed": 7,
  "device": "cpu",
  "total_steps": 32,
  "rollout_steps": 16,
  "num_epochs": 4,
  "minibatch_size": 512,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_ratio": 0.2,
  "entropy_coef": 0.01,
