  "max_grad_norm": 0.5,
  "cost_penalty": 0.1,
  "network": {
    "hidden_sizes": [
      128,
      128
    ],
    "activation": "tanh"
  },
  "output": {
    "checkpoint": "outputs/runs/mappo_method1_test/checkpoints/mappo_latest.pt",
    "metrics": "outputs/runs/mappo_method1_test/metrics/mappo_train.json"
  }
}